{
  "manifest_version": 3,
  "name": "GeM Bulk Model Scraper",
  "version": "1.0",
  "description": "Scrapes full product specs from GeM using Model Numbers",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "src/popup.html"
  },
  "host_permissions": [
    "https://*.gem.gov.in/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.gem.gov.in/*", "https://*.mkp.gem.gov.in/*"],
      "js": ["src/content.js"]
    }
  ]
}